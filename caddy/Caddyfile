        health_timeout 10s
    
        # Connection settings
        transport http {
            tls_insecure_skip_verify
            keepalive 30s
            dial_timeout 10s
            response_header_timeout 30s
        }

        # Security
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # Circuit breaker
        lb_policy random
        max_conns 100
    }

    # Rate limiting
    rate_limit {
        zone dynamic sonar_zone {
            key {remote_host}
            events 50
            window 1m
        }
    }
}

# Nexus - devops stack
nexus.lab-urbanos.local {
    import common_headers

    # Reverse proxy to Nexus
    reverse_proxy devops_nexus:8081 {
        # Health checks
        health_uri /service/rest/v1/status
        health_interval 30s
        health_timeout 10s
        
        # Connection settings
        transport http {
            tls_insecure_skip_verify
            keepalive 30s
            dial_timeout 10s
            response_header_timeout 30s
        }
        
        # Security
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Port {port}
        
        # Circuit breaker
        lb_policy random
        max_conns 100
    }
    
    # Rate limiting
    rate_limit {
        zone dynamic nexus_zone {
            key {remote_host}
            events 20
            window 1m
        }
    }
}
  
